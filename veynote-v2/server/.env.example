# MySQL connection — replace with your own credentials.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/veynote_v2"

PORT=4000
CLIENT_URL="http://localhost:5173"

# Any long random string — used to sign login sessions.
JWT_SECRET="replace-this-with-a-long-random-string"

# Google SSO — create an OAuth 2.0 Client ID in Google Cloud Console
# (APIs & Services > Credentials) with this exact callback URL:
#   http://localhost:4000/api/auth/google/callback
# Production callback: https://api.veynote.app/api/auth/google/callback
# Set GOOGLE_CALLBACK_URL explicitly if your public API uses another URL.
# Leave blank to report Google sign-in as unavailable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""

# Account recovery / email verification. Use credentials supplied by your
# email provider; never put these in client/.env. Leave blank until configured.
# TLS is mandatory: port 465 uses implicit TLS; 587 requires STARTTLS.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Optional stable secret of at least 32 characters for encrypted delivery jobs.
# Falls back to a purpose-derived JWT_SECRET key when omitted.
AUTH_EMAIL_SECRET=""
