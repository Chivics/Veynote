// Veynote V2 — Prisma schema
// Datasource: MySQL (per explicit request — NOT PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Mode {
  NOTES
  TRADING
}

enum Direction {
  LONG
  SHORT
}

enum TradeResult {
  WIN
  LOSS
  BREAKEVEN
  OPEN
}

enum AccountStatus {
  EVALUATION
  FUNDED
  PERSONAL
  BREACHED
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String?  // null when the account was created via Google SSO only
  googleId        String?  @unique
  avatarUrl       String?
  defaultMode     Mode     @default(NOTES)
  lastActiveNotesPath   String? // remembers "where you left off" per mode, per §2 of the design board
  lastActiveTradingPath String?
  theme           String   @default("dark") // dark | light | system
  editorFontSize  String   @default("medium") // small | medium | large
  timezone        String   @default("Africa/Lagos")
  locale          String   @default("NG")
  // Separate, independent passwords gating the Locked Notes and Will &
  // Inheritance areas — distinct from the account's login password, so
  // someone with an unlocked device/session still can't see either
  // without a second secret. Null means that vault hasn't been set up yet.
  lockedNotesPasswordHash String?
  willPasswordHash        String?
  // Holds the WebAuthn challenge between "generate options" and "verify
  // response" — this app has no session store, so it's parked here
  // instead. Single-slot is fine: registration and authentication are
  // never in flight for the same user at the same time in practice.
  webauthnChallenge          String?
  webauthnChallengeExpiresAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  folders         Folder[]
  notes           Note[]
  tags            Tag[]
  tradingAccounts TradingAccount[]
  tradingEntries  TradingEntry[]
  calendarEvents  CalendarEvent[]
  libraryItems    LibraryItem[]
  tasks           Task[]
  tradingRules    TradingRule[]
  attachments     Attachment[]
  tradeImages     TradeImage[]
  fileNodes       FileNode[]
  webauthnCredentials WebAuthnCredential[]
}

model Folder {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  color      String   @default("#7c6cff")
  icon       String   @default("📁")
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notes Note[]

  @@index([userId])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  notes NoteTag[]

  @@unique([userId, name])
}

model Note {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title      String
  content    String    @db.LongText
  mood       String?
  isFavorite Boolean   @default(false)
  isPinned   Boolean   @default(false)
  isArchived Boolean   @default(false)
  isTrashed  Boolean   @default(false)
  trashedAt  DateTime?
  // isLocked = sits in the Locked Notes vault (any note can be toggled).
  // isWill = THE Will & Inheritance document — a single dedicated note
  // per user, created lazily the first time that section is opened.
  // Both require their own vault token to read/write; see security.routes.js.
  isLocked   Boolean   @default(false)
  isWill     Boolean   @default(false)
  entryDate  DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tags           NoteTag[]
  calendarEvents CalendarEvent[]
  attachments    Attachment[]

  @@index([userId])
  @@index([folderId])
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model TradingAccount {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  broker    String? // e.g. "GoatFunded", "FundedNext", or blank for personal
  status    AccountStatus @default(PERSONAL)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  entries TradingEntry[]

  @@index([userId])
}

model TradingEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?
  account   TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  isTrade   Boolean  @default(true) // false = plain journal note logged in Trading Journal mode
  title     String
  content   String   @db.LongText

  asset          String?
  direction      Direction?
  entryPrice     Float?
  stopLoss       Float?
  takeProfit     Float?
  riskReward     Float?
  setupTypes     String?  // comma-separated: BOS,OB,LIQUIDITY_SWEEP,FVG,CUSTOM
  biasTimeframe  String?  // e.g. "Daily/4H"
  setupTimeframe String?  // e.g. "1H"
  entryTimeframe String?  // e.g. "15M/5M"
  confidence     Int?     // 1-10
  result         TradeResult @default(OPEN)
  achievedR      Float?

  psychologyBefore String? @db.Text
  psychologyDuring String? @db.Text
  psychologyAfter  String? @db.Text

  // Post-trade documentation — distinct from the psychology fields above,
  // which are about mental/emotional state. These are the objective
  // trade-review write-up.
  postTradeWhatHappened String? @db.Text
  postTradeWentRight    String? @db.Text
  postTradeWentWrong    String? @db.Text
  postTradeLesson       String? @db.Text

  isFavorite Boolean  @default(false)
  entryDate  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  calendarEvents CalendarEvent[]
  tradeImages TradeImage[]
  attachments Attachment[]

  @@index([userId])
  @@index([accountId])
}

// User-created calendar items for either mode. System/observance events
// (holidays) are NOT stored per-user — they're computed at request time
// by the calendar route (see server/src/data/holidays.js) so they never
// need to be seeded or duplicated per account.
model CalendarEvent {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           Mode
  date           DateTime
  title          String
  time           String? // optional clock time, free text e.g. "6:00 PM"
  linkedNoteId   String?
  linkedNote     Note?    @relation(fields: [linkedNoteId], references: [id], onDelete: SetNull)
  linkedTradeId  String?
  linkedTrade    TradingEntry? @relation(fields: [linkedTradeId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([userId, mode, date])
}

// ---------------------------------------------------------------------
// LIBRARY (added in the second design pass — Reading & Watching, Life
// Goals, Travel Plans, Bucket List, Ideas, Projects).
//
// IMPLEMENTATION NOTE (flagging per your "identify before deciding"
// instruction — this is a backend data-modeling choice, not a UI
// change): the board specifies six databases with six different property
// sets. Rather than six near-identical Prisma models + six route files,
// this uses ONE LibraryItem model with a `database` field to say which
// section it belongs to, and a `properties` JSON column to hold the
// fields that differ per database (e.g. Reading's Score/Author, Travel's
// Country/Budget, Goals' Progress/Target). The screens, columns, and
// empty states the user sees are exactly what's in the board — this
// only affects how it's stored, not how it looks or behaves.
// ---------------------------------------------------------------------
enum LibraryDatabase {
  READING
  LIFE_GOALS
  TRAVEL_PLANS
  BUCKET_LIST
  IDEAS
  PROJECTS
}

model LibraryItem {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  database   LibraryDatabase
  title      String
  category   String? // Type (Reading) / Category (Goals, Bucket, Ideas, Projects)
  status     String?
  priority   String?
  notes      String?         @db.Text
  link       String?
  properties Json? // database-specific extra fields — see client/src/data/libraryConfig.js
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, database])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  status      TaskStatus @default(TODO)
  priority    String?
  description String?    @db.Text
  dueDate     DateTime?
  tags        String? // comma-separated
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  subtasks TaskSubtask[]
  comments TaskComment[]

  @@index([userId])
}

model TaskSubtask {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([taskId])
}

// TRADING RULES — lives inside the existing Trading Journal, not a
// separate journal (per explicit instruction).
model TradingRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule      String
  category  String?
  priority  String?
  status    String   @default("Active")
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Trade Images — supports multiple screenshots per trade, each tagged
// with a stage (which part of the trade it documents) and, for setup
// images specifically, a timeframe (Monthly/Weekly/Daily/4H/1H/15M/etc.)
// so a trader can attach their full top-down analysis, not just one chart.
enum TradeImageStage {
  SETUP // the analysis that led to the trade — usually multiple timeframes
  ENTRY // the actual entry trigger/confirmation
  DURING_TRADE // management, partial TP, adjustments while the trade was live
  POST_TRADE // after-the-fact review, outcome, or annotated chart
  OTHER
}

model TradeImage {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingEntryId String
  tradingEntry TradingEntry    @relation(fields: [tradingEntryId], references: [id], onDelete: Cascade)
  stage        TradeImageStage
  timeframe    String? // free text: "Monthly" | "Weekly" | "Daily" | "4H" | "1H" | "15M" | "5M" | custom
  caption      String?
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime        @default(now())

  @@index([tradingEntryId])
  @@index([userId])
}

// Real file/image attachments on a note. Files themselves live on disk
// under server/uploads/ (see src/index.js static route + src/routes/
// attachments.routes.js); this row just tracks the metadata and which
// note/user it belongs to. `kind` distinguishes an inline image (embedded
// directly in the note body via an <img> tag) from a generic downloadable
// file attachment (shown as a file chip, not embedded in the text).
enum AttachmentKind {
  IMAGE
  FILE
}

model Attachment {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Exactly one of noteId / tradingEntryId is set — an attachment belongs
  // to either a Note or a TradingEntry, never both. Both are optional at
  // the DB level (Prisma has no clean XOR constraint); the routes enforce
  // that invariant.
  noteId       String?
  note         Note?          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tradingEntryId String?
  tradingEntry TradingEntry?  @relation(fields: [tradingEntryId], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  originalName String
  storedName   String // the actual filename on disk (randomized, avoids collisions)
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime       @default(now())

  @@index([noteId])
  @@index([tradingEntryId])
  @@index([userId])
}

// A device-folder upload tree. When someone uploads an entire folder
// (via the browser's directory picker), each subfolder becomes a
// FileNode with isDirectory=true, and each file becomes a leaf FileNode
// under it — preserving the structure they had on disk, rather than
// flattening everything into one note per file the way the old "Import
// from device" button did.
model FileNode {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?    // null = top level of the Files browser
  parent      FileNode?  @relation("FileNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    FileNode[] @relation("FileNodeChildren")

  name        String
  isDirectory Boolean    @default(false)

  // Only set when isDirectory is false.
  storedName  String?    // randomized filename on disk
  mimeType    String?
  sizeBytes   Int?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([parentId])
}

// A registered passkey/security key for unlocking Locked Notes.
// Deliberately scoped to that one purpose (not Will & Inheritance, which
// stays password-only) per the product spec. counter is used to detect
// cloned-authenticator replay attacks, per the WebAuthn spec.
model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  transports   String?  // JSON array, e.g. ["internal","hybrid"]
  deviceLabel  String?  // e.g. "Chrome on macOS" — set client-side at registration time
  createdAt    DateTime @default(now())

  @@index([userId])
}
